<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet serve solo alla sincronizzazione del file cifrato, che si accende con un interruttore. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Lettura delle carte contactless avvicinandole: solo numero e scadenza, sul telefono. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-permission android:name="${suitePermission}" />
    <!-- Permesso della suite: solo le app Eurise firmate con la stessa chiave (Eurise Tastiera) leggono i codici 2FA. -->
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_password"
        android:label="@string/pwd_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EurisePassword">
        <provider
            android:name=".keyboard.CodesProvider"
            android:authorities="${applicationId}.codes"
            android:exported="true"
            android:readPermission="${suitePermission}" />
        <activity
            android:name=".PasswordActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Codici 2FA da un QR: la voce si apre precompilata e si salva solo se la persona conferma. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="otpauth" />
                <data android:scheme="otpauth-migration" />
            </intent-filter>
            <!-- Importazione: si apre un file esportato o lo si condivide con Password, senza cercarlo a mano. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-keepass2" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Voci mandate dalle altre app della suite (chiave di recupero della Chat): solo con il permesso della suite. -->
        <activity-alias
            android:name=".AddFromSuite"
            android:targetActivity=".PasswordActivity"
            android:exported="true"
            android:permission="${suitePermission}">
            <intent-filter>
                <action android:name="eu.eurise.action.ADD_PASSWORD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".autofill.FillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EurisePassword.Sheet"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".autofill.EuriseAutofillService"
            android:exported="true"
            android:label="@string/pwd_app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
        <service android:name=".LockTile" android:exported="true" android:icon="@drawable/ic_tile_lock"
            android:label="@string/pwd_tile_lock" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".GenerateTile" android:exported="true" android:icon="@drawable/ic_tile_key"
            android:label="@string/pwd_tile_generate" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <activity
            android:name=".passkey.PasskeyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.EurisePassword.Sheet"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".passkey.EuriseCredentialService"
            android:enabled="@bool/pwd_passkeys_supported"
            android:exported="true"
            android:label="@string/pwd_app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data android:name="android.credentials.provider" android:resource="@xml/credentials_provider" />
        </service>
    </application>
    <queries>
        <!-- Eurise Leggi: legge le carte con la fotocamera, solo tra app con la stessa firma. -->
        <package android:name="eu.eurise.read" />
        <package android:name="eu.eurise.read.debug" />
    </queries>
</manifest>
