    <string name="eurise_search_online_note">Only the words you typed leave the phone, never your position.</string>
    <string name="eurise_search_download">Download maps</string>
    <string name="eurise_search_online_title">Search online too?</string>
    <string name="eurise_search_online_explain">When the maps on this phone find nothing, Eurise Maps can ask Photon (OpenStreetMap data, komoot, Germany). It receives only the words you searched: no position, no phone identifier. Nothing is saved on the phone except the results. You can switch it off from the results with one tap.</string>
