<?xml version="1.0" encoding="utf-8"?>
<!--
  Eurise (tavola MapOrizzontaleGuida): in orizzontale la barra della guida sta in colonna a sinistra (Segnala, Sosta,
  Voce, Insieme, Fine). Il menu a scomparsa di CoMaps resta nel layout, nascosto: i suoi pulsanti (voce, stop, «Manda
  l'arrivo») fanno il lavoro quando li tocca la barra, e l'arrivo si legge in fondo alla colonna della manovra.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/navigation_frame"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <include layout="@layout/layout_nav_top" />

  <androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/nav_bottom_sheet_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
      android:id="@+id/nav_bottom_sheet_background"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone" />

    <FrameLayout
      android:id="@+id/nav_bottom_sheet"
      style="?attr/bottomSheetStyle"
      android:layout_width="@dimen/nav_menu_landscape_width"
      android:layout_height="wrap_content"
      android:layout_gravity="start"
      app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

      <include layout="@layout/layout_nav_bottom" />
    </FrameLayout>

  </androidx.coordinatorlayout.widget.CoordinatorLayout>

  <androidx.compose.ui.platform.ComposeView
    android:id="@+id/eurise_guida_bar"
    android:layout_width="68dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:layout_marginStart="14dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp" />

  <View
    android:id="@+id/nav_bottom_sheet_nav_bar"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_gravity="bottom|start" />
</FrameLayout>
