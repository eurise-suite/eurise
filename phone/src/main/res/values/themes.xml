    <style name="Theme.EurisePhone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ph_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ph_icon_background</item>
    </style>
    <!-- Schermata della chiamata: sempre blu notte, come nelle anteprime. -->
