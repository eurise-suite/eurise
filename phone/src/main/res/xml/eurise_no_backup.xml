<?xml version="1.0" encoding="utf-8"?>
<!--
    Niente backup nel cloud di Google né trasferimento automatico da telefono a telefono (Android 12 e oltre: allowBackup="false"
    da solo non ferma il trasferimento). I dati passano solo dal backup cifrato della suite (docs/SICUREZZA.md).
    Anche la memoria «protetta del dispositivo» (device_*), dove la Tastiera tiene ciò che ha imparato.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
