<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Chiamate, registro e rubrica: tutto resta sul telefono. Nessun permesso Internet. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Facoltativo: gli impegni con la persona durante la chiamata («Prima di rispondere»). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- La chiamata in corso come servizio in primo piano: la pillola verde nella barra di stato riporta alla chiamata. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="${suitePermission}" />
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />

    <queries>
        <package android:name="eu.eurise.hub" />
        <package android:name="eu.eurise.hub.debug" />
        <!-- «Invita sulla Chat» dalla scheda della Rubrica. -->
        <package android:name="eu.eurise.chat" />
        <package android:name="eu.eurise.chat.debug" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thoughtcrime.securesms" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/eurise_no_backup"
        android:icon="@mipmap/ic_phone"
        android:label="@string/ph_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EurisePhone">
        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Necessari per essere l'app delle chiamate (ruolo «Telefono»). -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <!-- «Mostra le chiamate» (registro): così le chiamate perse non aprono il Telefono di sistema. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/calls" />
            </intent-filter>
        </activity>
        <!-- «Apri con › Rubrica» per i file .vcf (15 novembre). -->
        <activity
            android:name=".VcfImportActivity"
            android:exported="true"
            android:label="@string/ph_contacts_app"
            android:icon="@mipmap/ic_contacts"
            android:excludeFromRecents="true"
            android:taskAffinity="eu.eurise.phone.importa">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/directory" />
            </intent-filter>
        </activity>
        <!-- Rubrica: la stessa app con la sua icona nel cassetto; apre i contatti e riceve «Aggiungi in rubrica». -->
        <activity-alias
            android:name=".ContactsAlias"
            android:exported="true"
            android:icon="@mipmap/ic_contacts"
            android:label="@string/ph_contacts_app"
            android:targetActivity=".PhoneActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
            </intent-filter>
        </activity-alias>
        <!-- «Una persona, tutti i canali»: dalla Chat si chiama con un tocco. Solo app della suite (permesso di firma). -->
        <activity-alias
            android:name=".SuiteCall"
            android:exported="true"
            android:permission="${suitePermission}"
            android:targetActivity=".PhoneActivity">
            <intent-filter>
                <action android:name="eu.eurise.action.SUITE_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity-alias>
        <!-- Chiamate con la nota e Rubrica per la Chat, solo app della suite (controllato in call()). -->
        <provider
            android:name=".data.PeopleProvider"
            android:authorities="${applicationId}.persone"
            android:exported="true" />
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:autoRemoveFromRecents="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="eu.eurise.phone.call"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.EurisePhone.Call" />
        <service
            android:name=".call.CallService"
            android:exported="true"
            android:foregroundServiceType="phoneCall"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <!-- Filtro antispam: Android lo chiama per ogni chiamata in arrivo quando Eurise Telefono è l'app predefinita. -->
        <service
            android:name=".call.SpamScreening"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />
        <!-- Chiamate perse: da app predefinita le affida a noi il sistema (che manda la richiesta con READ_PHONE_STATE).
             Si legge solo il registro sul telefono: chi la mandasse da fuori fa solo ricontrollare il registro. -->
        <receiver
            android:name=".call.MissedCallsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
