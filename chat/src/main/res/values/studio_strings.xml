<resources>
    <string name="st_title">Studio</string>
    <string name="st_intro">Un posto solo per le richieste dei tuoi pazienti: ricette, appuntamenti, referti e messaggi, da Chat, Email e SMS, in una coda. Le urgenze sempre in cima.</string>
    <string name="st_intro_where">Restano su questo telefono</string>
    <string name="st_intro_where_sub">Pazienti, consensi e coda sono cifrati con una chiave che non esce dal telefono. Nessun servizio esterno.</string>
    <string name="st_intro_apps">Email e Messaggi passano solo i pazienti</string>
    <string name="st_intro_apps_sub">Ti mandano qui i messaggi delle persone che aggiungi come pazienti; gli altri restano dove sono.</string>
    <string name="st_intro_patients">Li aggiungi tu, uno alla volta</string>
    <string name="st_intro_patients_sub">Con la verifica in studio: QR e codice, così sai che la chat è proprio la sua.</string>
    <string name="st_intro_legal">Prima di usarlo con i pazienti: informativa e consenso fatti controllare da un esperto. Spegnere lo Studio non cancella nulla.</string>
    <string name="st_turn_on">Accendi lo Studio</string>
    <string name="st_turn_off">Spegni lo Studio</string>
    <string name="st_turn_off_sub">Da spento niente entra più in coda ed Email e Messaggi non riconoscono i pazienti. I dati restano sul telefono, cifrati: riaccendendolo ritrovi tutto.</string>
