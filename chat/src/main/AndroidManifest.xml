<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- I propri turni nel calendario «Turni» del telefono (tavola ChatTurniCrea): chiesto solo accendendo l'interruttore. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- I vocali (tavola ChatVocali): chiesto solo la prima volta che si tiene premuto il microfono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Posizione dal vivo (tavola ChatPosizione): chiesta solo alla prima condivisione; servizio in primo piano con l'avviso fisso. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="${suitePermission}" />
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />

    <!-- L'app Eurise (backup cifrato della suite) ed Eurise Password, per la chiave di recupero. -->
    <queries>
        <package android:name="eu.eurise.hub" />
        <package android:name="eu.eurise.hub.debug" />
        <package android:name="eu.eurise.password" />
        <package android:name="eu.eurise.password.debug" />
        <!-- «Una persona, tutti i canali»: SMS, chiamate con la nota, Rubrica ed email delle app della suite. -->
        <package android:name="eu.eurise.messages" />
        <package android:name="eu.eurise.messages.debug" />
        <package android:name="eu.eurise.phone" />
        <package android:name="eu.eurise.phone.debug" />
        <package android:name="eu.eurise.mail" />
        <package android:name="eu.eurise.mail.debug" />
        <!-- Vocali (tavola ChatVocali): trascrizione con Eurise Voce e lettura con il motore di sintesi del telefono. -->
        <package android:name="eu.eurise.voice" />
        <!-- Riassunto dei messaggi (tavola ChatRiassunto): Eurise AI sul telefono. -->
        <package android:name="eu.eurise.ai" />
        <package android:name="eu.eurise.ai.debug" />
        <package android:name="eu.eurise.voice.debug" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/eurise_no_backup"
        android:icon="@mipmap/ic_chat"
        android:roundIcon="@mipmap/ic_chat"
        android:label="@string/ch_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EuriseChat">
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ritorno dall'accesso nel browser (SSO di Matrix). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eurisechat" android:host="login" />
            </intent-filter>
            <!-- Ricordamelo (tavola ChatProgramma): il link al messaggio nelle note dell'attività. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="eurisechat" android:host="messaggio" />
            </intent-filter>
        </activity>
        <!-- Lo Studio medico per Email e Messaggi: solo app della suite (permesso di firma, controllato in call()). -->
        <!-- Per la Rubrica: chi sono sulla Chat (link dell'invito). Solo app della suite (controllato in call()). -->
        <provider
            android:name=".ChatPeopleProvider"
            android:authorities="${applicationId}.persone"
            android:exported="true" />
        <provider
            android:name=".StudioProvider"
            android:authorities="${applicationId}.studio"
            android:exported="true" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chat_paths" />
        </provider>
        <!-- Backup della suite: le impostazioni, solo verso l'app Eurise (docs/stato/BACKUP.md). -->
        <provider
            android:name=".backup.ChatBackupProvider"
            android:authorities="${applicationId}.eurise.backup"
            android:exported="true"
            android:readPermission="${suitePermission}"
            android:writePermission="${suitePermission}" />
        <!-- Posizione dal vivo (tavola ChatPosizione): solo mentre la si condivide, con l'avviso fisso e «Smetti». -->
        <service
            android:name=".LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
