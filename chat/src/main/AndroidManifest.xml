<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- I propri turni nel calendario «Turni» del telefono (tavola ChatTurniCrea): chiesto solo accendendo l'interruttore. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="${suitePermission}" />
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />

    <!-- L'app Eurise (backup cifrato della suite) ed Eurise Password, per la chiave di recupero. -->
    <queries>
        <package android:name="eu.eurise.hub" />
        <package android:name="eu.eurise.hub.debug" />
        <package android:name="eu.eurise.password" />
        <package android:name="eu.eurise.password.debug" />
        <!-- «Una persona, tutti i canali»: SMS, chiamate con la nota, Rubrica ed email delle app della suite. -->
        <package android:name="eu.eurise.messages" />
        <package android:name="eu.eurise.messages.debug" />
        <package android:name="eu.eurise.phone" />
        <package android:name="eu.eurise.phone.debug" />
        <package android:name="eu.eurise.mail" />
        <package android:name="eu.eurise.mail.debug" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_chat"
        android:roundIcon="@mipmap/ic_chat"
        android:label="@string/ch_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EuriseChat">
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ritorno dall'accesso nel browser (SSO di Matrix). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eurisechat" android:host="login" />
            </intent-filter>
        </activity>
        <!-- Lo Studio medico per Email e Messaggi: solo app della suite (permesso di firma, controllato in call()). -->
        <!-- Per la Rubrica: chi sono sulla Chat (link dell'invito). Solo app della suite (controllato in call()). -->
        <provider
            android:name=".ChatPeopleProvider"
            android:authorities="${applicationId}.persone"
            android:exported="true" />
        <provider
            android:name=".StudioProvider"
            android:authorities="${applicationId}.studio"
            android:exported="true" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chat_paths" />
        </provider>
    </application>
</manifest>
