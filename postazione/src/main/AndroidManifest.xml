<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nessuna rete: la Postazione mostra solo ciò che è sul telefono (Compila APK lo controlla a ogni giro). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Preferiti da chiamare nella scheda Viaggio: spento di base, chiesto solo accendendo la funzione dopo la spiegazione. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- «Dove hai lasciato l'auto»: spento di base; la posizione si legge una volta, quando tocchi «Segna qui». -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Le altre app della suite: solo quelle firmate con la stessa chiave. -->
    <uses-permission android:name="${suitePermission}" />
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />

    <!-- Una schermata iniziale deve vedere le app che si possono aprire (non tutte le app: niente QUERY_ALL_PACKAGES). -->
    <queries>
        <package android:name="${hubPackage}" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="android.intent.action.DIAL" /></intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA" /></intent>
        <intent><action android:name="android.intent.action.SHOW_ALARMS" /></intent>
        <!-- La lente: «Cerca sul web» con il browser scelto. -->
        <intent><action android:name="android.intent.action.WEB_SEARCH" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/eurise_no_backup"
        android:icon="@mipmap/ic_postazione"
        android:label="@string/postazione_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EurisePostazione">

        <!-- Schermata iniziale (si sceglie in Impostazioni › App predefinite) e anche app normale, per provarla. -->
        <activity
            android:name=".PostazioneActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Il centro privacy dell'app Eurise apre qui le impostazioni della Postazione: solo app con la stessa firma. -->
        <activity-alias
            android:name=".DaEurise"
            android:targetActivity=".PostazioneActivity"
            android:exported="true"
            android:permission="${suitePermission}">
            <intent-filter>
                <action android:name="eu.eurise.action.OPEN_FROM_HUB" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- I tre interruttori della Postazione nel centro privacy: risponde solo all'app Eurise (controllo nel codice). -->
        <provider
            android:name=".data.CentroPrivacy"
            android:authorities="${applicationId}.hub"
            android:exported="true"
            android:permission="${suitePermission}" />

        <!--
            «Da rispondere» e la musica che suona: accesso alle notifiche, spento di base. Solo il sistema può legarsi a
            questo servizio (permesso BIND_NOTIFICATION_LISTENER_SERVICE); si accende e si spegne nelle impostazioni di Android.
        -->
        <service
            android:name=".data.AscoltoService"
            android:exported="true"
            android:label="@string/ascolto_nome"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
