<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solo quando si chiede ad Alfred di chiamare qualcuno; senza, si apre il tastierino con il numero. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Alfred che ascolta: il microfono si chiede al primo tocco; registra Alfred stesso, l'audio va solo a Eurise Voce
         (che trascrive sul telefono) o, senza Voce, al riconoscimento del telefono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- La finestra AI di Alfred (tavola AlfFinestra): la web app dell'AI scelta, col proprio account. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <activity
            android:name=".online.AiWindowActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
    <queries>
        <!-- «Da un'app installata»: le app che accettano un testo condiviso. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="eu.eurise.voice" />
        <package android:name="eu.eurise.voice.debug" />
        <package android:name="eu.eurise.maps" />
        <package android:name="eu.eurise.ai" />
        <package android:name="eu.eurise.ai.debug" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- La voce di Alfred: i motori di sintesi del telefono (Eurise Voce o quello di sistema). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- La musica di Alfred: l'app scelta dall'utente riceve titolo e autore del brano («riproduci da ricerca»). -->
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
    </queries>
</manifest>
