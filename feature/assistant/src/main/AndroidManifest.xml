<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solo quando si chiede ad Alfred di chiamare qualcuno; senza, si apre il tastierino con il numero. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <queries>
        <package android:name="eu.eurise.voice" />
        <package android:name="eu.eurise.voice.debug" />
        <package android:name="eu.eurise.maps" />
        <package android:name="eu.eurise.ai" />
        <package android:name="eu.eurise.ai.debug" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
</manifest>
