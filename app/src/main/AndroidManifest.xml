<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Calendari del telefono (su /e/OS anche quelli di Murena): chiesti solo aprendo il Calendario. -->
    <!-- Permesso della suite: solo le app Eurise firmate con la stessa chiave possono usarlo (es. Orologio). -->
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />
    <uses-permission android:name="${suitePermission}" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".EuriseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eurise">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Un biglietto in PDF condiviso verso Eurise: si prepara il viaggio (letto sul telefono). -->
            <intent-filter android:label="@string/share_trip">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AodActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Eurise.Launcher"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Icona propria nell'elenco delle app, per aprirla e sceglierla come schermata iniziale. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Eurise Tastiera: riquadro di ricerca (Browser, AI) sopra l'app in cui si scrive. Solo app Eurise con la stessa firma. -->
        <activity
            android:name=".web.WebPopupActivity"
            android:exported="true"
            android:permission="${suitePermission}"
            android:excludeFromRecents="true"
            android:taskAffinity="eu.eurise.web"
            android:theme="@style/Theme.Eurise.Popup"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- File e Scanner con la loro icona tra le app di Android: aprono l'app Eurise su quella sezione. -->
        <activity
            android:name=".SectionShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity-alias
            android:name=".FileApp"
            android:exported="true"
            android:icon="@mipmap/ic_file"
            android:label="@string/app_file"
            android:targetActivity=".SectionShortcutActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="eu.eurise.section" android:value="drive" />
        </activity-alias>
        <activity-alias
            android:name=".ScannerApp"
            android:exported="true"
            android:icon="@mipmap/ic_scanner"
            android:label="@string/app_scanner"
            android:targetActivity=".SectionShortcutActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="eu.eurise.section" android:value="scanner" />
        </activity-alias>
        <!-- Eurise File: «Salva in…» e «Apri da…» per Office, Galleria e Browser. Solo app Eurise con la stessa firma. -->
        <activity
            android:name="eu.eurise.core.files.FilesActivity"
            android:exported="true"
            android:permission="${suitePermission}"
            android:excludeFromRecents="true"
            android:taskAffinity="eu.eurise.files"
            android:theme="@style/Theme.Eurise.Popup">
            <intent-filter>
                <action android:name="eu.eurise.action.SAVE_IN" />
                <action android:name="eu.eurise.action.OPEN_FROM" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="eu.eurise.action.OPEN_FROM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Eurise Tastiera: attività e note create dalla tastiera. Solo app Eurise con la stessa firma. -->
        <receiver
            android:name=".KeyboardBridgeReceiver"
            android:exported="true"
            android:permission="${suitePermission}">
            <intent-filter>
                <action android:name="eu.eurise.action.KEYBOARD_TASK" />
                <action android:name="eu.eurise.action.KEYBOARD_NOTE" />
            </intent-filter>
        </receiver>
        <!-- Segreti affidati dagli altri APK della suite (chiave di recupero della Chat): nel backup cifrato. -->
        <provider
            android:name=".SecretsProvider"
            android:authorities="${applicationId}.secrets"
            android:exported="true"
            android:permission="${suitePermission}" />
        <!-- «Dove devi andare» per Eurise Mappe: impegni con un luogo, senza rete. -->
        <provider
            android:name=".DestinationsProvider"
            android:authorities="${applicationId}.destinations"
            android:exported="true"
            android:permission="${suitePermission}" />
        <!-- Meteo sul percorso per Eurise Mappe (passa dal centro privacy). -->
        <provider
            android:name=".RouteWeatherProvider"
            android:authorities="${applicationId}.routeweather"
            android:exported="true"
            android:permission="${suitePermission}" />
    </application>
</manifest>
