<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Calendari del telefono (su /e/OS anche quelli di Murena): chiesti solo aprendo il Calendario. -->
    <!-- Permesso della suite: solo le app Eurise firmate con la stessa chiave possono usarlo (es. Orologio). -->
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />
    <uses-permission android:name="${suitePermission}" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".EuriseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eurise">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Un biglietto in PDF condiviso verso Eurise: si prepara il viaggio (letto sul telefono). -->
            <intent-filter android:label="@string/share_trip">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AodActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:turnScreenOn="true" />
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Eurise.Launcher"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Icona propria nell'elenco delle app, per aprirla e sceglierla come schermata iniziale. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Eurise Tastiera: riquadro di ricerca (Browser, AI) sopra l'app in cui si scrive. Solo app Eurise con la stessa firma. -->
        <activity
            android:name=".web.WebPopupActivity"
            android:exported="true"
            android:permission="${suitePermission}"
            android:excludeFromRecents="true"
            android:taskAffinity="eu.eurise.web"
            android:theme="@style/Theme.Eurise.Popup"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />
        <!-- Eurise Tastiera: attività e note create dalla tastiera. Solo app Eurise con la stessa firma. -->
        <receiver
            android:name=".KeyboardBridgeReceiver"
            android:exported="true"
            android:permission="${suitePermission}">
            <intent-filter>
                <action android:name="eu.eurise.action.KEYBOARD_TASK" />
                <action android:name="eu.eurise.action.KEYBOARD_NOTE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
