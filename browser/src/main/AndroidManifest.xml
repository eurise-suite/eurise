<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="${suitePermission}" />
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />

    <queries>
        <package android:name="eu.eurise.hub" />
        <package android:name="eu.eurise.hub.debug" />
        <!-- Eurise Password (Impostazioni › Password) e i browser da cui importare (tavola BrwImportaPwd). -->
        <package android:name="eu.eurise.password" />
        <package android:name="eu.eurise.password.debug" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.vivaldi.browser.snapshot" />
        <package android:name="com.android.chrome" />
        <package android:name="com.brave.browser" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="org.mozilla.firefox_beta" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_browser"
        android:label="@string/brw_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EuriseBrowser">
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Password e segnalibri condivisi da un altro browser («Esporta» → Eurise): niente file da cercare. -->
            <intent-filter android:label="@string/brw_import_share_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>
        <!-- Webapp da «In home»: una finestra per sito, nelle recenti con il suo nome. -->
        <activity
            android:name=".WebAppActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:taskAffinity=""
            android:autoRemoveFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density" />
        <provider
            android:name="eu.eurise.browser.SaveProvider"
            android:authorities="${applicationId}.salva"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/save_paths" />
        </provider>
    </application>
</manifest>
