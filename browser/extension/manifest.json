{
  "manifest_version": 2,
  "name": "Eurise",
  "version": "0.2.0",
  "description": "Eurise nella pagina: In Note, Da fare, Ascolta, Traduci. Stessa estensione sul telefono (GeckoView) e sul computer (Firefox).",
  "browser_specific_settings": {
    "gecko": {
      "id": "eurise@eurise.eu"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}