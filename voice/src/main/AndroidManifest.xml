<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Il microfono si chiede alla prima dettatura. Internet serve solo a scaricare il modello scelto. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permesso della suite: solo le app Eurise firmate con la stessa chiave aprono la dettatura per sé. -->
    <permission android:name="${suitePermission}" android:protectionLevel="signature" />
    <uses-permission android:name="${suitePermission}" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_voice"
        android:label="@string/voice_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EuriseVoice">
        <activity
            android:name=".DictateActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Trascrizione per Alfred: l'audio arriva già registrato da lui; solo le app della suite (stessa firma). -->
        <service
            android:name=".TranscribeService"
            android:exported="true"
            android:permission="${suitePermission}">
            <intent-filter>
                <action android:name="eu.eurise.action.TRANSCRIBE" />
            </intent-filter>
        </service>
        <!-- La voce di Alfred come motore di sintesi del telefono: riceve solo il testo da leggere, che non esce. -->
        <service
            android:name=".speech.AlfredVoiceService"
            android:exported="true"
            android:label="@string/voice_tts_engine">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/tts_engine" />
        </service>
        <!-- Modelli e voci da scaricare: dalla suite, dalle impostazioni della sintesi del telefono e da Voce. -->
        <activity
            android:name=".ModelsActivity"
            android:exported="true"
            android:label="@string/voice_models_title"
            android:theme="@style/Theme.EuriseVoice">
            <intent-filter>
                <action android:name="eu.eurise.action.VOICE_MODELS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
