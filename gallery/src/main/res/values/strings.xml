    <string name="cloud_title">Caricamento sul cloud</string>
    <string name="cloud_switch">Carica le foto</string>
    <string name="cloud_explain_title">Cosa cambia per la tua privacy</string>
    <string name="cloud_explain">Cosa viene letto: le foto e i video delle cartelle che scegli, interi, compresa la posizione salvata dentro.\n\nDove vanno: su %1$s, in Eurise/Foto, senza cifratura aggiuntiva.\n\nChi li vede: il tuo account e chi gestisce quel servizio.\n\nCome si torna indietro: spegni l\'interruttore; quanto è già caricato resta sul cloud finché non lo togli.</string>
    <string name="cloud_explain_ok">Accendi</string>
    <string name="cloud_account">Dove</string>
    <string name="cloud_link_murena">Collega Murena</string>
